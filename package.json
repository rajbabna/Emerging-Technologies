{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-proposal.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-proposal.mjs",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:pages": "node scripts/build-static.mjs && wrangler pages deploy out --project-name emerging-tech-lms --branch main --commit-dirty=true",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
